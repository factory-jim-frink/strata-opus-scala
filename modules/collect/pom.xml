<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  
  <parent>
    <groupId>com.opengamma.strata</groupId>
    <artifactId>strata-parent</artifactId>
    <version>2.12.78-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>  
  <artifactId>strata-collect</artifactId>
  <packaging>jar</packaging>
  <name>Strata-Collect</name>
  <description>Common collection implementations</description>

  <!-- ==================================================================== -->
  <dependencies>
    <!-- Third party -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>
    <dependency>
      <groupId>org.joda</groupId>
      <artifactId>joda-beans</artifactId>
    </dependency>
    <dependency>
      <groupId>org.joda</groupId>
      <artifactId>joda-convert</artifactId>
    </dependency>
    <!-- Scala runtime for the Scala 3.9.0 implementation of this module -->
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala3-library_3</artifactId>
      <version>${scala.version}</version>
    </dependency>
    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- ==================================================================== -->
  <build>
    <resources>
      <!-- Include all standard resources -->
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>com/opengamma/strata/collect/version.properties</exclude>
        </excludes>
      </resource>
      <!-- Include filtered version.properties -->
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>com/opengamma/strata/collect/version.properties</include>
        </includes>
        <filtering>true</filtering>
      </resource>
      <!-- Include LICENSE/NOTICE in jar files -->
      <resource>
        <directory>${root.dir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE.txt</include>
          <include>NOTICE.txt</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Compile the Scala 3.9.0 implementation (Java tests remain compiled by maven-compiler-plugin) -->
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
        <version>4.10.0</version>
        <executions>
          <execution>
            <id>scala-compile-first</id>
            <phase>process-resources</phase>
            <goals>
              <goal>add-source</goal>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <scalaVersion>${scala.version}</scalaVersion>
          <release>17</release>
          <compileOrder>Mixed</compileOrder>
          <sendJavaToScalac>true</sendJavaToScalac>
          <args>
            <arg>-deprecation</arg>
            <arg>-feature</arg>
            <!-- only emit trait/default-method forwarders that the JVM needs, as Java classes have none -->
            <arg>-Xmixin-force-forwarders:false</arg>
          </args>
          <!-- scaladoc 3.9.0 resolves jackson-annotations 2.13, which lacks JsonSerializeAs needed by its Jackson 3.1 -->
          <additionalDependencies>
            <additionalDependency>
              <groupId>com.fasterxml.jackson.core</groupId>
              <artifactId>jackson-annotations</artifactId>
              <version>2.21</version>
            </additionalDependency>
          </additionalDependencies>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jboss.bridger</groupId>
        <artifactId>bridger</artifactId>
        <executions>
          <execution>
            <id>weave</id>
            <phase>process-classes</phase>
            <goals>
              <goal>transform</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Build-only restoration of Java bytecode metadata that Scala 3 does not emit: -->
      <!-- @SafeVarargs on eight Guavate varargs methods and throws IOException on two ArrayByteSource bridges. -->
      <!-- Runs after Bridger; ASM and the Scala compiler are plugin dependencies only and nothing is packaged. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>compile-build-helpers</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/build-classes" />
                <javac srcdir="${project.basedir}/src/build/java" destdir="${project.build.directory}/build-classes"
                    classpathref="maven.plugin.classpath" includeantruntime="false" release="8" encoding="UTF-8"
                    debug="true" failonerror="true">
                  <compilerarg value="-Xlint:all" />
                  <compilerarg value="-Werror" />
                </javac>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>restore-safevarargs</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <java classname="RestoreSafeVarargs" fork="true" failonerror="true">
                  <classpath>
                    <pathelement location="${project.build.directory}/build-classes" />
                    <path refid="maven.plugin.classpath" />
                  </classpath>
                  <arg file="${project.build.outputDirectory}" />
                </java>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>restore-bridge-exceptions</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <java classname="RestoreBridgeExceptions" fork="true" failonerror="true">
                  <classpath>
                    <pathelement location="${project.build.directory}/build-classes" />
                    <path refid="maven.plugin.classpath" />
                  </classpath>
                  <arg file="${project.build.outputDirectory}" />
                </java>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>restore-safevarargs-controls</id>
            <phase>test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <!-- the controls are tests of the build helpers, so they follow -DskipTests -->
              <skip>${skipTests}</skip>
              <target>
                <mkdir dir="${project.build.directory}/build-test-classes" />
                <javac srcdir="${project.basedir}/src/build/test" destdir="${project.build.directory}/build-test-classes"
                    includeantruntime="false" release="8" encoding="UTF-8" debug="true" failonerror="true">
                  <classpath>
                    <pathelement location="${project.build.directory}/build-classes" />
                    <path refid="maven.plugin.classpath" />
                  </classpath>
                  <compilerarg value="-Xlint:all" />
                  <compilerarg value="-Werror" />
                </javac>
                <java classname="RestoreSafeVarargsControls" fork="true" failonerror="true">
                  <classpath>
                    <pathelement location="${project.build.directory}/build-test-classes" />
                    <pathelement location="${project.build.directory}/build-classes" />
                    <path refid="maven.plugin.classpath" />
                  </classpath>
                  <arg file="${project.build.outputDirectory}" />
                </java>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>restore-bridge-exceptions-controls</id>
            <phase>test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <!-- the controls are tests of the build helpers, so they follow -DskipTests -->
              <skip>${skipTests}</skip>
              <target>
                <!-- a real Scala 3 class with ArrayByteSource's bridge shape, compiled outside target/classes -->
                <mkdir dir="${project.build.directory}/build-test-fixtures" />
                <property name="fixture.classpath" refid="maven.compile.classpath" />
                <java classname="dotty.tools.dotc.Main" classpathref="maven.plugin.classpath" fork="true"
                    failonerror="true">
                  <arg value="-release" />
                  <arg value="17" />
                  <arg value="-d" />
                  <arg file="${project.build.directory}/build-test-fixtures" />
                  <arg value="-classpath" />
                  <arg value="${fixture.classpath}" />
                  <arg file="${project.basedir}/src/build/test-fixtures/ArrayByteSource.scala" />
                </java>
                <java classname="RestoreBridgeExceptionsControls" fork="true" failonerror="true">
                  <classpath>
                    <pathelement location="${project.build.directory}/build-test-classes" />
                    <pathelement location="${project.build.directory}/build-classes" />
                    <path refid="maven.plugin.classpath" />
                    <!-- Guava, so the restored Scala fixture can be loaded and its bridges invoked -->
                    <path refid="maven.compile.classpath" />
                  </classpath>
                  <arg file="${project.build.outputDirectory}" />
                  <arg file="${project.build.directory}/build-test-fixtures" />
                </java>
              </target>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.5</version>
          </dependency>
          <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-compiler_3</artifactId>
            <version>${scala.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

  <!-- ==================================================================== -->
  <profiles>
    <!-- With -Ddist, publish the ScalaDoc as this module's javadoc jar (javadoc finds no Java classes here) -->
    <profile>
      <id>scaladoc-jar</id>
      <activation>
        <property>
          <name>dist</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>net.alchim31.maven</groupId>
            <artifactId>scala-maven-plugin</artifactId>
            <version>4.10.0</version>
            <executions>
              <execution>
                <id>attach-scaladoc</id>
                <!-- doc-jar forks the lifecycle up to compile, which would recompile the classes changed by -->
                <!-- the restorers below; before them the compile is a no-op and the restored classes stay -->
                <phase>process-classes</phase>
                <goals>
                  <goal>doc-jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <!-- ==================================================================== -->
  <properties>
    <scala.version>3.9.0</scala.version>
    <jpms.module.name>com.opengamma.strata.collect</jpms.module.name>
    <!-- Locate the root directory of the multi-module build -->
    <root.dir>${project.basedir}/../..</root.dir>
    <!-- The implementation is Scala: maven-javadoc-plugin is skipped and -Ddist attaches the ScalaDoc instead -->
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- Properties for maven-javadoc-plugin -->
    <windowtitle>OpenGamma Strata Collect</windowtitle>
    <doctitle><![CDATA[<h1>OpenGamma Strata Collect API</h1>]]></doctitle>
  </properties>

</project>
