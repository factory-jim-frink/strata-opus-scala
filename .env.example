##############################################################################
# Strata environment reference
#
# Strata is a Java library. It does not read a .env file: configuration is loaded
# from the classpath and from JVM system properties (see
# modules/basics/src/main/resources/META-INF/com/opengamma/strata/config/README.md).
#
# This file documents the environment variables that the build, the test suite and
# the release process actually consume, so a CI run can be reproduced locally and so
# agents do not have to guess what a setup step expects.
#
# Nothing below is needed to clone, build, test, or run the examples. Only the
# "Release and deploy" group is needed to publish artifacts, and those values are
# secrets that must never be committed. `.env` is ignored by git: keep real values
# there (or in your CI secret store) and leave this template as it is.
#
# To use it:
#   cp .env.example .env      # then fill in the values you need
#   set -a; . ./.env; set +a  # export everything for the current shell
##############################################################################

# ---------------------------------------------------------------------------
# Build and test
# ---------------------------------------------------------------------------

# JVM options applied to every JVM the build starts, including the forked surefire
# JVMs. CircleCI sets -XX:MaxRAM=3572m because the JVM does not see the cgroup
# memory limit of the container. This is also the most convenient way to pass the
# system property documented below to test and example JVMs.
# .circleci/config.yml (executors)
JAVA_TOOL_OPTIONS=-XX:MaxRAM=3572m

# JVM options for the Maven process itself. CircleCI uses a 1 GB heap.
# .circleci/config.yml (executors)
MAVEN_OPTS=-Xmx1g

# Strata's only runtime knob. It is a JVM system property, not an environment
# variable, and it changes the set of configuration directories that ResourceConfig
# searches on the classpath. The default is base, base1..base9, library,
# library1..library9, application, application1..application9, searched from lowest
# priority to highest.
# com/opengamma/strata/collect/io/ResourceConfig.java
# Pass it through JAVA_TOOL_OPTIONS or MAVEN_OPTS, for example:
# JAVA_TOOL_OPTIONS=-Dcom.opengamma.strata.config.directories=base,library,application,user

# ---------------------------------------------------------------------------
# Release and deploy (secrets, CI only)
# ---------------------------------------------------------------------------

# Sonatype credentials, referenced by the `central` server in
# .circleci/maven-settings.xml and used by `mvn deploy -Doss.repo`.
OSS_SONATYPE_USER=
OSS_SONATYPE_PASSWORD=

# OpenGamma Artifactory credentials, referenced by the `opengamma-repo` server.
ARTIFACTORY_USER=
ARTIFACTORY_PASSWORD=

# Token for the `github` server: the passphrase for the release signing key and the
# credential for the github-release-maven-plugin.
GITHUB_TOKEN=

# Passphrase used to decrypt .circleci/codesigning.asc.gpg during a release.
# .circleci/config.yml (setup_gpg)
SIGNING_PASSWORD=

# ---------------------------------------------------------------------------
# CircleCI-provided, informational only, do not set locally
# ---------------------------------------------------------------------------

# CIRCLE_TAG    - the git tag that triggered a release build
# CIRCLE_JOB    - the CircleCI job name, used to key the Maven cache
# CACHE_VERSION - version prefix for the Maven cache
